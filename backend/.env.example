# ── Groq (AI) ─────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq periodically deprecates/retires model IDs (it already happened once
# to this project). These are checked against https://console.groq.com/docs/models
# (text) and https://console.groq.com/docs/vision (vision, must support
# image input) -- if you ever see a "model_not_found" error, that's Groq
# retiring a model; update the value here instead of touching any code.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── Supabase ──────────────────────────────────────────────────────────
# Project Settings -> API (or the "Connect" button on your project dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> "Publishable and secret API keys" tab.
# If you only see an "anon" and "service_role" key and a
# "Create new API keys" button, click it first -- this generates the
# newer sb_publishable_... / sb_secret_... pair alongside your existing
# legacy keys (nothing existing breaks). Use the SECRET key here.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ── CORS ──────────────────────────────────────────────────────────────
# The URL your frontend runs on (this project's Vite dev server uses 3000)
FRONTEND_ORIGIN=http://localhost:3000
